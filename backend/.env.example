PORT=8787
# Shared secret: browser sends Authorization: Bearer <same value> via VITE_API_SECRET
API_SECRET=

GROQ_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Identity verification (Didit) ───────────────────────────────────────────
# From the Didit console (Business Console → API & Webhooks / Workflows).
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Webhook secret shown when you add the webhook URL
#   https://<your-railway-domain>/webhooks/didit   (subscribe to status.updated)
DIDIT_WEBHOOK_SECRET=
# Where Didit sends the freelancer after the check, e.g. https://<your-app>/freelancer
DIDIT_CALLBACK_URL=
# Long random secret (openssl rand -hex 32). Never change it after launch:
# identity hashes depend on it, so a new salt lets every person verify again.
IDENTITY_HASH_SALT=
# Secret of the contract's appointed VERIFIER key (not the owner key).
VERIFIER_SECRET_KEY=
SECUREFLOW_CONTRACT_ID=CAJAUKTFKRYZCIFCQOGNZJMCJITC574Z5DUFRINMXXR7VIYKRBEFPS7H

# Autopilot (AI job manager). A dedicated Stellar key the client appoints with
# set_job_manager; it can hire, approve, reject and dispute, never move funds.
AUTOPILOT_SECRET_KEY=
# Use xAI Grok when set; otherwise falls back to GROQ_API_KEY.
XAI_API_KEY=
# Optional overrides
AUTOPILOT_MODEL=
AUTOPILOT_VERIFIED_EDGE=10
AUTOPILOT_HIRE_THRESHOLD=60
# Mount a volume here on hosts with an ephemeral disk.
AUTOPILOT_DATA_DIR=data
